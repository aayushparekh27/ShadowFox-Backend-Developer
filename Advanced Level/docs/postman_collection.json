{
  "info": {
    "name": "Advanced Level - ClientPulse Enterprise API",
    "description": "Postman collection for ClientPulse Enterprise Project Management & Deliverable Review API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Admin Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@agency.com\",\n  \"password\": \"AdminPass123!\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "2. Freelancer Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"freelancer@agency.com\",\n  \"password\": \"FreelancerPass123!\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "3. Client Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"client@acme.com\",\n  \"password\": \"ClientPass123!\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "4. Get All Projects",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api", "projects"] }
      }
    },
    {
      "name": "5. Freelancer Submit Deliverable",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{freelancerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Phase 1 Architecture Pull Request\",\n  \"deliverableUrl\": \"https://github.com/agency/banking-portal/pull/42\",\n  \"notes\": \"All API endpoints and OAuth tests built and passed 100%.\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/milestones/1/deliverables", "host": ["{{baseUrl}}"], "path": ["api", "milestones", "1", "deliverables"] }
      }
    },
    {
      "name": "6. Client Approve Deliverable (Auto-Generates Invoice)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{clientToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"decision\": \"APPROVED\",\n  \"feedbackNotes\": \"Code review approved and verified on staging server.\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/deliverables/1/review", "host": ["{{baseUrl}}"], "path": ["api", "deliverables", "1", "review"] }
      }
    },
    {
      "name": "7. View Generated Invoices",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/invoices", "host": ["{{baseUrl}}"], "path": ["api", "invoices"] }
      }
    },
    {
      "name": "8. View Compliance Audit Logs",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/audit-logs", "host": ["{{baseUrl}}"], "path": ["api", "audit-logs"] }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3003" },
    { "key": "adminToken", "value": "YOUR_ADMIN_JWT_TOKEN" },
    { "key": "freelancerToken", "value": "YOUR_FREELANCER_JWT_TOKEN" },
    { "key": "clientToken", "value": "YOUR_CLIENT_JWT_TOKEN" }
  ]
}
